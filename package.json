{
  "name": "steeny-client",
  "version": "2.1.7",
  "description": "Безопасный Electron-клиент для музыкального сервиса STEENY",
  "main": "src/main.js",
  "author": {
    "name": "Ivan0n",
    "email": "Ivan0n@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ivan0n/SteenyClient.git"
  },
  "desktopName": "steeny.desktop",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/auth.js && node --check src/rpc.js && node --check src/updater.js && node --check src/window-resource-manager.js && node --check src/renderer-recovery.js && node --check src/window-state.js",
    "test": "node --test test/*.test.js",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb rpm --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appId": "fun.steeny.desktop",
    "productName": "STEENY",
    "executableName": "steeny",
    "artifactName": "STEENY-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "!src/settings.json",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ivan0n",
        "repo": "SteenyClient",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "forceCodeSigning": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "STEENY-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "AudioVideo;Audio;Player",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    },
    "appImage": {
      "artifactName": "STEENY-linux-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
